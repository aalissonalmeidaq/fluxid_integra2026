<?xml version="1.0" encoding="utf-8"?>
<!-- Só no build de debug: libera HTTP para o Supabase local alcançado pelo cabo (`adb reverse tcp:54321 tcp:54321`).
     O build de release não tem este arquivo e continua bloqueando tráfego sem criptografia. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
