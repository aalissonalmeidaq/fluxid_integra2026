# Seleção do Supabase: auto, local, lan ou cloud.
VITE_SUPABASE_CONNECTION_MODE=auto

# Instância do Supabase CLI neste mesmo dispositivo. Em desenvolvimento (npm run dev:rede), se a página for aberta
# por outro aparelho da rede, o app usa o repasse do próprio Vite (/supabase-local) em vez de 127.0.0.1; não é preciso mudar este valor.
VITE_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
VITE_SUPABASE_LOCAL_PUBLISHABLE_KEY=

# Instância homologada na rede local. Use HTTPS fora de desenvolvimento isolado.
VITE_SUPABASE_LAN_URL=
VITE_SUPABASE_LAN_PUBLISHABLE_KEY=

# Projeto gerenciado na nuvem usado como fallback autorizado.
VITE_SUPABASE_CLOUD_URL=
VITE_SUPABASE_CLOUD_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=

# URL pública permitida para concluir o fluxo PKCE de recuperação.
PASSWORD_RECOVERY_REDIRECT_URL=http://127.0.0.1:3000/recuperar-senha/confirmar

# Produção LAN/cloud exige SMTP homologado; nunca registre valores reais neste arquivo.
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_PORT=
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASSWORD=

# Tempo máximo de cada verificação de disponibilidade, em milissegundos.
VITE_SUPABASE_PROBE_TIMEOUT_MS=2000

# Versão pública esperada do contrato/schema exposta por cada destino (RF-047).
VITE_SUPABASE_CONTRACT_VERSION=002.1

# Chave VAPID pública das notificações dos lacres (Spec 012). Pública por definição; a privada fica só na função seal-push.
VITE_VAPID_PUBLIC_KEY=

# Botão "Acessos de teste" da tela de login (Spec 014). Configuração pública, lida no build: só "false" desliga, e então o modal e as
# credenciais de demonstração nem entram no pacote. Ausente ou qualquer outro valor: o botão aparece.
VITE_DEMO_ACCESS=

# --- Somente servidor (Edge Functions). Nunca use o prefixo VITE_ nem leia estes nomes no cliente. ---

# Destino do link do convite de acesso; use uma URL pública permitida da aplicação.
INVITATION_REDIRECT_URL=

# Limite de envios de foto por identidade, por hora (padrão seguro definido na função).
AVATAR_UPLOADS_PER_HOUR=

# Segredo do job de limpeza de fotos anonimizadas. Gere um valor aleatório no servidor e guarde-o só nos segredos
# do Supabase e do agendador; nunca registre o valor aqui.
RETENTION_JOB_SECRET=

# --- Geocodificação do protótipo (Nominatim). Integração TEMPORÁRIA, exclusiva do protótipo; detalhes em docs/geocodificacao-prototipo.md ---

# Liga a busca de coordenadas pelo endereço. Desligada por padrão; só o valor "true" liga.
GEOCODING_ENABLED=true
# Provedor registrado em supabase/functions/geocode-address/registry.ts.
GEOCODING_PROVIDER=nominatim
# false bloqueia a busca para endereço de cadastro de pessoa física.
GEOCODING_ALLOW_PERSONAL_ADDRESSES=false
# true exige a confirmação explícita da pessoa antes de enviar o endereço ao serviço externo.
GEOCODING_REQUIRE_TRANSMISSION_CONFIRMATION=true
# Limite global ao provedor; nunca acima de 1 requisição por segundo.
GEOCODING_RATE_LIMIT_PER_SECOND=1
# Retenção do cache de coordenadas, em dias (1 a 90; padrão 30).
GEOCODING_CACHE_TTL_DAYS=30
# Notificações dos lacres (Spec 012), na função seal-push: par VAPID (a privada nunca vai para o cliente) e contato do remetente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<contato-da-equipe>
# Sal do resumo do endereço de origem na função seal-gateway (limite de chaves erradas). Obrigatório na nuvem; valor aleatório.
SEAL_SOURCE_SALT=
