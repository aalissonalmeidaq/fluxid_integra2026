{
  "name": "fluxid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rede": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tokens:gerar": "node scripts/design-system/gerar-tokens-css.mjs",
    "catalogo:dev": "vite --config vite.catalogo.config.ts",
    "catalogo:build": "vite build --config vite.catalogo.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=desktop-chromium --project=tablet-webkit --project=tablet-768 --project=desktop-1920 --project=mobile-360-chromium",
    "test:visual": "playwright test --project=visual-chromium",
    "test:visual:atualizar": "node scripts/design-system/atualizar-capturas-visuais.mjs",
    "ia:registro": "node scripts/governanca-ia/gerar-registro-ia.mjs",
    "ia:validar": "node scripts/governanca-ia/validar-registro-ia.mjs --staged",
    "ia:hooks": "node scripts/governanca-ia/instalar-hooks.mjs",
    "test:desempenho:cilindros": "node scripts/cilindros/medir-desempenho-4g.mjs",
    "test:desempenho:registro": "node scripts/registro/medir-desempenho-4g.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "bwip-js": "^4.11.4",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite-plugin-pwa": "1.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/parser": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "typescript-eslint": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    }
  }
}
